<View>
  <Header value="$trap · $captured_at · feedback: $feedback"/>
  <Text name="notes" value="$notes"/>
  <!-- Labels above the photo so the buttons stay visible on tall portrait photos.
       Magenta = Bemisia; cyan "Cek" = low-confidence model box to confirm (turn into
       Bemisia) or delete. Every "Cek" must be resolved before Submit. -->
  <RectangleLabels name="label" toName="image" strokeWidth="2" opacity="0.1">
    <Label value="Bemisia" background="#E5007E" hotkey="b"/>
    <Label value="Cek" background="#00B7FF" hotkey="c"/>
  </RectangleLabels>
  <Image name="image" value="$image" zoom="true" zoomControl="true" zoomBy="1.5" rotateControl="false"/>
</View>
